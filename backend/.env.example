# Ambiente: development | test | production
VAULT_ENVIRONMENT=development

# Banco. Em produção, Postgres:
# VAULT_DATABASE_URL=postgresql+psycopg://vault:senha@localhost:5432/vault
VAULT_DATABASE_URL=sqlite+pysqlite:///./vault_dev.db

# Chave-mestra (KEK), 32 bytes em base64. Gere com:
#   python -m app.tools.gerar_chave
# Em produção esta chave vive no KMS e este campo fica vazio.
VAULT_MASTER_KEY_B64=

# Segredo de assinatura dos tokens, 32+ bytes.
# Em desenvolvimento, se vazio, um efêmero é gerado a cada reinício.
VAULT_JWT_SECRET=

VAULT_ACCESS_TOKEN_MINUTES=15
VAULT_REFRESH_TOKEN_DAYS=7
